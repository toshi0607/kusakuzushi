# Local overrides for `wrangler dev` (not secrets — committed on purpose).
# Origins that may call /mcp from JavaScript while developing: the Vite
# preview (Playwright) and dev servers. Production keeps the [vars] value in
# wrangler.toml. A `--var ALLOWED_ORIGINS:<url>` works too; this file just
# keeps the list in one place. wrangler dev maps its own origin
# (http://127.0.0.1:8787) to the route host, so that one can never be
# allowlisted — probe with the preview origin instead.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173

{
  "name": "kusakuzushi",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config playwright.production.config.ts",
    "typecheck:e2e": "pnpm --filter @kusakuzushi/web exec tsc -p ../../e2e/tsconfig.json",
    "build": "pnpm -r build",
    "lh": "pnpm --filter @kusakuzushi/web build && lhci autorun",
    "lh:slow": "pnpm --filter @kusakuzushi/web build && KUSAKUZUSHI_LH_TARGET=slow lhci autorun",
    "lh:prod": "KUSAKUZUSHI_LH_TARGET=production lhci autorun",
    "deploy:web": "pnpm --filter @kusakuzushi/web run deploy",
    "deploy:ogp": "pnpm --filter @kusakuzushi/ogp run deploy",
    "deploy:mcp": "pnpm --filter @kusakuzushi/mcp run deploy",
    "verify:web": "node tools/verify-deploy.mjs",
    "verify:ogp": "node tools/verify-worker.mjs",
    "verify:mcp": "node tools/verify-mcp.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2"
  }
}

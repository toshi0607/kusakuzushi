{
  "manifest_version": 3,
  "name": "草崩し (Kusakuzushi)",
  "version": "0.0.1",
  "description": "GitHub のプロフィールページの草を、その場でブロック崩しにする",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
